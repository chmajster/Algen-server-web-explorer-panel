# WebNAS reads application settings from the YAML file selected here.
# Copy this file to .env only for local tooling; production systemd units
# should set WEBNAS_CONFIG to /etc/webnas/config.yaml.
WEBNAS_CONFIG=./config.example.yaml

# Optional variables accepted by the standalone Hosts Manager agent installer.
# Keep enrollment tokens short-lived and never commit a populated value.
HOSTS_MANAGER_URL=https://hosts-manager.example.com
HOSTS_MANAGER_TOKEN=
