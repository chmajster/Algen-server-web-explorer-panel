{
  "name": "webnas-frontend",
  "private": true,
  "version": "0.1.31",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "postbuild": "node -e \"console.log('[INFO] Frontend bundle built. Installer next: validating dist.next, publishing assets, atomically activating index.html, verifying the active bundle, and applying file ownership.')\"",
    "build:analyze": "npm run build && node scripts/analyze-bundle.mjs",
    "bundle:report": "node scripts/analyze-bundle.mjs",
    "bundle:check": "node scripts/analyze-bundle.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=line",
    "test:e2e:real": "playwright test --config=playwright.real.config.ts",
    "api:generate": "node scripts/api-contract.mjs generate",
    "api:check": "node scripts/api-contract.mjs check",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "0.552.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.47.0",
    "@typescript-eslint/parser": "8.47.0",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.7.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
