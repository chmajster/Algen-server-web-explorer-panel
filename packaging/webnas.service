[Unit]
Description=WebNAS web administration panel
After=network-online.target
Wants=network-online.target
Requires=webnas-privileged.socket
After=webnas-privileged.socket
StartLimitIntervalSec=120
# systemd counts the initial start, so four starts allow three automatic retries.
StartLimitBurst=4

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60s
WorkingDirectory=/opt/webnas/backend
Environment=PYTHONPATH=/opt/webnas/backend
Environment=WEBNAS_CONFIG=/etc/webnas/config.yaml
ExecStart=/opt/webnas/backend/.venv/bin/python -m app.run
Restart=on-failure
RestartSec=30
# WebNAS uses PAM, user-context file workers and validated package operations.
User=webnas
Group=webnas
Environment=WEBNAS_PRIVILEGED_BROKER=required
NoNewPrivileges=true
PrivateTmp=true
# Package managers require writes below /etc, /usr and /var.
ProtectSystem=false
# Path policy and per-user workers restrict access; the selected home must stay writable.
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# Validated package-manager jobs must be able to install distribution packages
# containing required SUID/SGID helpers (for example cifs-utils/mount.cifs).
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/webnas /var/log/webnas /home /mnt/webnas

[Install]
WantedBy=multi-user.target
